@* ============================================================================
   ТаблицаPartialView.cshtml
   Partial-представление для tbody таблицы PostgreSQL.

   Этот файл используется в двух местах:
   1. При первом открытии страницы через Html.PartialAsync(...).
   2. При обновлении таблицы через fetch('/Главная/ЧастичнаяОтрисовка').
   ============================================================================ *@

@using SignalRVisualizer.Models
@model МодельДляСтрокиИзБазы

@if (!string.IsNullOrWhiteSpace(Model?.ОшибкаЗагрузки))
{
    @* Если контроллер поймал ошибку подключения/SQL, показываем её в таблице. *@
    <tr class="строка-базы-данных строка-ошибки-бд">
        <td colspan="8">
            Не удалось загрузить данные из PostgreSQL: @Model.ОшибкаЗагрузки
        </td>
    </tr>
}
else if (Model?.ЛистДляТаблицыИзБазы == null || Model.ЛистДляТаблицыИзБазы.Count == 0)
{
    @* Пустой список — это не ошибка Razor. Показываем понятную строку пользователю. *@
    <tr class="строка-базы-данных строка-пустой-бд">
        <td colspan="8">
            Данных для отображения нет. Проверь таблицу "_Диспозиция_поковок_ТА" и диапазон "N_поз_ТА" от 1 до 4.
        </td>
    </tr>
}
else
{
    @* Обычный режим: каждая запись модели превращается в одну HTML-строку. *@
    foreach (var строка in Model.ЛистДляТаблицыИзБазы)
    {
        <tr class="строка-базы-данных">
            <td>@строка.N_ряда</td>
            <td>@строка.Прав_поток_номер_поковки</td>
            <td>@строка.Прав_поток_на_поддоне_количество</td>
            <td>@строка.Прав_поток_на_поддоне_ед_измерения</td>
            <td>@строка.Лев_поток_номер_поковки</td>
            <td>@строка.Лев_поток_на_поддоне_количество</td>
            <td>@строка.Лев_поток_на_поддоне_ед_измерения</td>
            <td>@строка.Старт</td>
        </tr>
    }
}
